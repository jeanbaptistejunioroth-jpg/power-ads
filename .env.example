# ── Supabase (Project Settings > API) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique : "anon" ou "publishable" selon l'âge du projet
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : UNIQUEMENT côté serveur (suppression de compte). Ne jamais l'exposer.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@vidsella.com
# Doit correspondre à "Email OTP Length" dans Supabase > Authentication > Providers > Email
NEXT_PUBLIC_OTP_LENGTH=6

# Anti-robots Cloudflare Turnstile (clé publique). Vide = pas de CAPTCHA.
# La clé secrète va UNIQUEMENT dans Supabase > Authentication > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Paiement (à brancher plus tard) ──────────────────────────
# URL de la page de paiement de ton prestataire. Vide = message "bientôt disponible".
PAYMENT_CHECKOUT_URL=

# Bonus de bienvenue : tokens offerts UNE fois quand un client enregistre pour la première fois
# un numéro WhatsApp qu'aucun autre compte n'utilise (migration 0006 requise).
# 0 = désactivé. Exemple : 55 = une vidéo de 15 s face caméra offerte (80 = 15 s style mixte).
WELCOME_BONUS_TOKENS=0

# ── Développement local ──────────────────────────────────────
# En local il n'y a pas d'en-tête pays : simule un pays (CM, FR, SN, US…)
DEV_COUNTRY=CM

# ── IA : rédaction des scripts (fal.ai, même clé que le moteur) ──
# Vide = scripts de démonstration (pour tester le parcours sans payer).
FAL_KEY=
# Modèle utilisé via l'endpoint OpenRouter de fal (vérifier le nom exact dans le catalogue).
SCRIPT_MODEL=anthropic/claude-sonnet-5.5

# ── Moteur de production n8n ─────────────────────────────────
# Adresse de réception des commandes. Vide = les commandes restent « en attente ».
# En local : http://localhost:5678/webhook/powerads/order
ENGINE_ORDER_URL=
# Doit être identique à ENGINE_WEBHOOK_SECRET dans le .env du moteur.
ENGINE_WEBHOOK_SECRET=
# Doit être identique à SITE_CALLBACK_SECRET dans le .env du moteur.
# Côté moteur : SITE_CALLBACK_URL=https://vidsella.com/api/engine/events
SITE_CALLBACK_SECRET=
